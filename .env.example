# Токен бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID администраторов через запятую (узнать свой ID можно командой /myid)
ADMIN_IDS=123456789

# Платформа для общего core_bot: telegram, vk или max
PLATFORM=telegram

# Телефоны мастера через запятую (для исключения мастера из клиентских напоминаний)
MASTER_PHONE=+70000000000
MASTER_PHONES=+70000000000,70000000000,80000000000

# ID мастера/админа по платформам (необязательно, через запятую)
# MASTER_TELEGRAM_IDS=100000001,100000002
# MASTER_VK_IDS=100000003
# MASTER_MAX_IDS=100000004
# MASTER_USER_IDS=

# Необязательные настройки (по умолчанию берутся из config.py)
# BOOKING_URL=https://srezforma.ru
# SALON_ADDRESS=Саратов, ул. имени Е.И. Пугачёва, 110
# SALON_LATITUDE=51.536988
# SALON_LONGITUDE=46.013896
# WORK_HOURS=Вторник и суббота: 10:00–19:00
# REFERRAL_REWARD_AMOUNT=300

# Единая база данных PostgreSQL для общей базы клиентов и рефералов между Telegram, VK и MAX
# Если не указана, используется локальная SQLite база данных (data/bot.db)
DATABASE_URL=postgresql://user:password@localhost:5432/booking_db?sslmode=disable
